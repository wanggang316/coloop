<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the-loop (macOS, per-user).

  Recommended: let the installer render and load this for you:
    ./scripts/install.sh --service

  Manual install: replace the @TOKENS@ below, then load it:
    @BIN@      -> absolute path to the installed binary (e.g. /usr/local/bin/the-loop)
    @CONFIG@   -> absolute path to your config       (e.g. /Users/you/.the-loop/config.yaml)
    @LOG@      -> absolute path for combined logs     (e.g. /Users/you/.the-loop/the-loop.log)

    cp deploy/com.theloop.the-loop.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.theloop.the-loop.plist
    tail -f ~/.the-loop/the-loop.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theloop.the-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>@BIN@</string>
    <string>--config</string>
    <string>@CONFIG@</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>
