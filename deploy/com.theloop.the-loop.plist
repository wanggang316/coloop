<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the-loop (macOS).
  Install (replace USERNAME with your account):
    cp dist/the-loop-darwin-arm64 /usr/local/bin/the-loop
    mkdir -p ~/.the-loop && cp config.example.yaml ~/.the-loop/config.yaml
    cp deploy/com.theloop.the-loop.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.theloop.the-loop.plist
    # logs: tail -f ~/.the-loop/the-loop.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theloop.the-loop</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/the-loop</string>
    <string>--config</string>
    <string>/Users/USERNAME/.the-loop/config.yaml</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.the-loop/the-loop.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.the-loop/the-loop.log</string>
</dict>
</plist>
